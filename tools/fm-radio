        self.seek_up_btn.set_sensitive(sensitive)

    # ---------- audio output ----------
    def _output_label(self, target):
        if target == "speaker":
            return "喇叭"
        if target == "headphones":
            return "有线耳机"
        return self._out_labels.get(target, "蓝牙设备")

    def _add_vol_drag(self, scale):
        # Gtk.Scale swallows button events, so the press is caught as it propagates
        scale.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        scale.connect("event", self._on_vol_press)
        scale.connect("button-release-event", self._on_vol_release)

    def _on_vol_press(self, scale, event):
        if event.type == Gdk.EventType.BUTTON_PRESS:
            alloc = scale.get_allocation()
            if 0 <= event.x <= alloc.width and 0 <= event.y <= alloc.height:
                self._vol_drag = True
        return False

    def _on_vol_release(self, scale, _event):
        self._vol_drag = False
        return False

    def _poll_volume(self):
        # follow volume changes made outside the app (media keys, GNOME mixer),
        # including while stopped: otherwise the level set in the mixer is
        # silently replaced by the stored one on the next play
        try:
            if self._switching or self._shutting_down or self.scanning:
                self._vol_pending = None
                return True
            if self._vol_drag:
                if int(self.vol_slider.get_value()) == self.volume:
                    self._vol_drag = False
                return True
            pct = self.player.get_volume()
            if pct is None or abs(pct - self.volume) < 2:
                self._vol_pending = None
                return True
            if self._vol_pending is not None and abs(self._vol_pending - pct) <= 1:
                self._vol_pending = None
                self.volume = pct
                self._set_volume_slider(pct)
                self._save()
            else:
                self._vol_pending = pct
        except Exception:
            pass
        return True

    def _set_volume_slider(self, value):
        self._vol_suppress = True
        self.vol_slider.set_value(value)
        self._vol_suppress = False

    def _refresh_antenna(self):
        st = jack_state()
        ctx = self.antenna_bar.get_style_context()
        ctx.remove_class("antenna-ok")
        ctx.remove_class("antenna-warn")
        if st is None:
            self.antenna_bar.set_text("天线：未知")
            ctx.add_class("antenna-warn")
        elif st:
            self.antenna_bar.set_text("天线：耳机已插入")
            ctx.add_class("antenna-ok")
        else:
            self.antenna_bar.set_text("⚠ 请插入耳机当天线")
            ctx.add_class("antenna-warn")

    def _refresh_outputs(self, initial=False):
        outs = list_outputs()
        ids = [t for t, _ in outs]
        labels = {t: l for t, l in outs}
        changed = ids != self._out_ids
        self._out_ids = ids
        self._out_labels = labels
        if initial or changed:
            self._out_suppress = True
            self.out_combo.remove_all()
            for t, l in outs:
                self.out_combo.append(t, l)
            self._out_suppress = False
        if self.output in ids:
            self._lost_handled = False
        elif not self._lost_handled and not self._out_failed:
            self._lost_handled = True
            fallback = "speaker" if "speaker" in ids else (ids[0] if ids else "speaker")
            if self.playing and not self._switching:
                self._start_output_switch(fallback, lost=True)
            else:
                self.output = fallback
                self._save()
        if self.output in ids:
            self._out_suppress = True
            if self.out_combo.get_active_id() != self.output:
                self.out_combo.set_active_id(self.output)
            self._out_suppress = False
        self._refresh_antenna()
        return changed

    def _poll_outputs(self):
        try:
            shown = bool(self.out_combo.get_property("popup-shown"))
        except Exception:
            shown = False
        if not shown:
            self._refresh_outputs()
            if self.playing and not self._switching and not self._out_failed:
                if self.player.sink and self.player.sink not in list_sinks():
                    self._start_output_switch(self.output, lost=True)
                elif not self.player.loopback_alive():
                    self._start_output_switch(self.output, lost=True)
        return True

    def _on_output(self, combo):
        if self._out_suppress or self.scanning or self._switching:
            return
        target = combo.get_active_id()
        if not target or target == self.output:
            return
        if self.playing:
            self._start_output_switch(target)
        else:
            self.output = target
            self.player.sink = sink_for(target)
            self.player.own_default_sink(self.player.sink)
            self.player.set_volume(self.volume)
            self._set_status("输出：%s" % self._output_label(target))
            self._save()

    def _start_output_switch(self, target, lost=False):
        self._switching = True
        self._out_failed = False
        self.output = target
        self._out_suppress = True
        self.out_combo.set_active_id(target)
        self._out_suppress = False
        self.out_combo.set_sensitive(False)
        self._save()
        self._set_status("输出设备已断开，正在切换…" if lost else "正在切换输出…")
        threading.Thread(target=self._switch_output_worker,
                         args=(target,), daemon=True).start()

    def _switch_output_worker(self, target):
        if self.spec:
            self.spec.stop()
            self.spec = None
        self.player.set_mute(True)
        with self._audio_lock:
            self.player.loopback_off()
            resolved = self.player.prepare(target)
            if resolved is None and target != "speaker":
                resolved = self.player.prepare("speaker")
            ok = resolved is not None
            if ok:
                final = resolved
                if not final.startswith(BT_PREFIX):
                    self.player.codec_path_on()
                self.player.set_volume(self.volume)
                loop_id = self.player.loopback_on()
                if loop_id is None and final.startswith(BT_PREFIX):
                    self.player.prepare("speaker")
                    final = "speaker"
                    loop_id = self.player.loopback_on()
                ok = loop_id is not None
                if ok:
                    self.fm.audio_on()
                    time.sleep(0.25)
            else:
                final = target
        self.player.set_mute(False)
        if ok:
            GLib.timeout_add(1200, self._reassert_volume, final)
            self.spec = Spectrum()
            self.spec.start()
        GLib.idle_add(self._after_output_switch, final, ok)

    def _reassert_volume(self, target):
        if self.playing and self.output == target:
            self.player.set_volume(self.volume)
        return False

    def _after_output_switch(self, final, ok):
        self._switching = False
        self._out_failed = not ok
        self.out_combo.set_sensitive(True)
        if ok:
            self.output = final
            self._refresh_outputs()
            self._out_suppress = True
            self.out_combo.set_active_id(final)
            self._out_suppress = False
            self._set_status("正在收听 · 输出：%s" % self._output_label(final))
            self._save()
        else:
            self._set_status("输出不可用，请换一个输出")
        return False

    def _on_slider(self, scale):
        if self._suppress:
            return
        self.current = round(scale.get_value(), 1)
        self.freq_label.set_text("%.1f" % self.current)
        if self._tune_source:
            GLib.source_remove(self._tune_source)
        self._tune_source = GLib.timeout_add(650, self._debounced_tune)

    def _debounced_tune(self):
        self._tune_source = 0
        self._apply_tune()
        return False

    def _step(self, delta):
        v = clamp(round(self.current + delta, 1), FM_MIN, FM_MAX)
        self._set_freq(v, tune=True)

    def _set_freq(self, mhz, tune=False):
        self.current = round(clamp(mhz, FM_MIN, FM_MAX), 1)
        self._suppress = True
        self.slider.set_value(self.current)
        self._suppress = False
        self.freq_label.set_text("%.1f" % self.current)
        if tune:
            self._apply_tune()

    def _apply_tune(self):
        if self.busy or self.scanning:
            return
        if self.rec.running():
            self._set_status("录音中不能调台，请先停止录音")
            return
        khz = int(round(self.current * 1000))
        self._set_busy(True)
        self._set_status("正在调谐…")

        def work():
            self.fm.init()
            if not self.output.startswith(BT_PREFIX):
                self.player.codec_path_on()
            flag, rssi, snr = self.fm.tune(khz)
            self.player.set_volume(self.volume)
            GLib.idle_add(self._after_tune, flag, rssi, snr)

        threading.Thread(target=work, daemon=True).start()

    def _after_tune(self, flag, rssi, snr):
        self._set_busy(False)
        if (flag is None or (flag & 3) != 1 or rssi is None):
            self._set_status("调谐失败（%.1f MHz）" % self.current)
            return False
        dbu = self.fm.rssi_dbu(rssi)
        extra = " · SNR %d" % snr if snr is not None else ""
        self._set_status("信号 %d dBuV%s · %s" % (dbu, extra,
                         "正在收听" if self.playing else "已调谐"))
        self._add_history(self.current, dbu)
        if not self.playing:
            self.fm.off()
        return False

    def _on_power(self, btn):
        if self.scanning:
            self._cancel_activity()
            return
        if self.busy:
            return
        if self.playing:
            self._stop_play()
        else:
            self._start_play()

    def _start_play(self):
        self._set_busy(True)
        self.power_btn.set_label("停止")
        ctx = self.power_btn.get_style_context()
        ctx.remove_class("play")
        ctx.add_class("stop")
        self._set_status("正在启动…")
        khz = int(round(self.current * 1000))
        self._out_failed = False
        target = self.output
        self._mark_active()

        def work():
            with self._audio_lock:
                resolved = self.player.prepare(target)
                if resolved is None and target != "speaker":
                    resolved = self.player.prepare("speaker")
                ok = resolved is not None
                final = resolved if ok else target
                self.fm.init()
                if ok and not final.startswith(BT_PREFIX):
                    self.player.codec_path_on()
                flag, rssi, snr = self.fm.tune(khz)
                if ok:
                    self.player.set_volume(self.volume)
                    self.player.loopback_on()
            if ok:
                GLib.timeout_add(1200, self._reassert_volume, final)
                self.spec = Spectrum()
                self.spec.start()
            GLib.idle_add(self._after_start, flag, rssi, snr, final, ok)

        threading.Thread(target=work, daemon=True).start()

    def _after_start(self, flag, rssi, snr, final, ok):
        self.playing = True
        self._set_busy(False)
        self._out_failed = not ok
        if ok and final != self.output:
            self.output = final
            self._out_suppress = True
            self.out_combo.set_active_id(final)
            self._out_suppress = False
            self._save()
        if flag is None or (flag & 3) != 1 or rssi is None:
            self._set_status("调谐失败（%.1f MHz）" % self.current)
        elif not ok:
            self._set_status("正在收听，但输出不可用")
        else:
            dbu = self.fm.rssi_dbu(rssi)
            extra = " · SNR %d" % snr if snr is not None else ""
            self._set_status("信号 %d dBuV%s · 输出：%s" %
                             (dbu, extra, self._output_label(self.output)))
            self._add_history(self.current, dbu)
        self.power_btn.set_label("■ 停止")
        return False

    def _cancel_activity(self):
        """Abort a running scan/seek and return to the stopped state."""
        self._cancel.set()
        self.scanning = False
        self.busy = False
        self._switching = False
        self.playing = False
        if self.spec:
            self.spec.stop()
            self.spec = None
        self.player.set_mute(True)
        with self._audio_lock:
            self.player.loopback_off()
            self.fm.off()
        self.player.set_mute(False)
        self.player.route_off()
        self._clear_active()
        self.progress.hide()
        self.scan_btn.set_sensitive(True)
        self.power_btn.set_sensitive(True)
        self._set_seek_sensitive(True)
        self.out_combo.set_sensitive(True)
        self._set_freq(self.current)
        self._render_spectrum()
        self._set_status("已停止")
        self.power_btn.set_label("▶ 开始收听")
        ctx = self.power_btn.get_style_context()
        ctx.remove_class("stop")
        ctx.add_class("play")

    def _stop_play(self):
        self.playing = False
        if self.spec:
            self.spec.stop()
            self.spec = None
        self.player.set_mute(True)
        with self._audio_lock:
            self.player.loopback_off()
            # a recording taps the capture node directly, so the tuner has to
            # stay powered when only the monitoring side is switched off
            if not self.rec.running():
                self.fm.off()
        self.player.set_mute(False)
        self.player.route_off()
        self._clear_active()
        self._render_spectrum()
        self._set_status("已静音（录音继续）" if self.rec.running() else "已停止")
        self.power_btn.set_label("▶ 开始收听")
        ctx = self.power_btn.get_style_context()
        ctx.remove_class("stop")
        ctx.add_class("play")

    def _scan_audio_begin(self):
        """Make the sweep audible; returns True if a temporary monitor started."""
        if self._cancel.is_set():
            return False
        if self.playing:
            with self._audio_lock:
                if not self.player.sink.startswith(BT_PREFIX):
                    self.player.codec_path_on()
                self.player.set_volume(self.volume)
            return False
        target = self.output
        with self._audio_lock:
            resolved = self.player.prepare(target)
            if resolved is None and target != "speaker":
                resolved = self.player.prepare("speaker")
        if resolved is None or self._cancel.is_set():
            return False
        with self._audio_lock:
            if not resolved.startswith(BT_PREFIX):
                self.player.codec_path_on()
            self.player.set_volume(self.volume)
            self.player.loopback_on()
        if self._cancel.is_set():
            with self._audio_lock:
                self.player.loopback_off()
            return False
        self._mark_active()
        return True

    def _scan_audio_end(self, temporary):
        if not temporary:
            return
        self.player.set_mute(True)
        with self._audio_lock:
            self.player.loopback_off()
            self.fm.off()
        self.player.set_mute(False)
        self._clear_active()

    def _on_scan(self, btn):
        if self.busy or self.scanning or self._switching:
            return
        if self.rec.running():
            self._set_status("录音中不能搜台，请先停止录音")
            return
        self.scanning = True
        self._cancel.clear()
        self.scan_btn.set_sensitive(False)
        self.power_btn.set_sensitive(True)
        self.power_btn.set_label("■ 停止")
        ctx = self.power_btn.get_style_context()
        ctx.remove_class("play")
        ctx.add_class("stop")
        self.out_combo.set_sensitive(False)
        self._set_seek_sensitive(False)
        self.progress.show()
        self.progress.set_fraction(0)
        self._set_status("搜台中…")
        start = self.current

        def work():
            temporary = self._scan_audio_begin()
            if self._cancel.is_set():
                return
            self.fm.init(rds=False)
            self.fm.audio_on()
            found = []
            total = int((FM_MAX - FM_MIN) * 10) + 1
            for idx, step in enumerate(range(int(FM_MIN * 10), int(FM_MAX * 10) + 1)):
                if self._cancel.is_set():
                    return
                khz = step * 100
                GLib.idle_add(self._scan_tick, step / 10.0, 0.75 * idx / total)
                flag, rssi, snr = self.fm.tune_wait(khz)
                self.fm.audio_on()
                if flag is None or (flag & 3) != 1 or rssi is None or snr is None:
                    continue
                dbu = self.fm.rssi_dbu(rssi)
                if dbu >= SCAN_RSSI_MIN and snr >= SCAN_SNR_MIN:
                    found.append({"mhz": round(step / 10.0, 1),
                                  "rssi": dbu, "snr": snr})

            # group the shoulders of one carrier, keep its strongest bin
            found.sort(key=lambda s: s["mhz"])
            clusters = []
            for hit in found:
                if clusters and hit["mhz"] - clusters[-1]["last"] <= 0.35:
                    clusters[-1]["hits"].append(hit)
                    clusters[-1]["last"] = hit["mhz"]
                else:
                    clusters.append({"last": hit["mhz"], "hits": [hit]})
            best = [max(c["hits"], key=lambda h: (h["snr"], h["rssi"]))
                    for c in clusters]
            best.sort(key=lambda h: (-h["snr"], -h["rssi"]))
            candidates = best[:16]

            # second pass: settle longer and require the station again
            picked = []
            for i, cand in enumerate(candidates):
                if self._cancel.is_set():
                    return
                GLib.idle_add(self._scan_verify, cand["mhz"], i, len(candidates))
                khz = int(round(cand["mhz"] * 1000))
                flag, rssi, snr = self.fm.tune_wait(khz)
                self.fm.audio_on()
                if flag is None or (flag & 3) != 1 or rssi is None or snr is None:
                    continue
                dbu = self.fm.rssi_dbu(rssi)
                if dbu < VERIFY_RSSI_MIN or snr < VERIFY_SNR_MIN:
                    continue
                item = {"mhz": cand["mhz"], "rssi": dbu, "snr": snr}
                picked.append(item)
                if len(picked) >= 15:
                    break

            if self._cancel.is_set():
                return
            self.fm.tune(int(round(start * 1000)))
            if not self.playing:
                self.fm.off()
            self._scan_audio_end(temporary)
            GLib.idle_add(self._after_scan, picked)

        threading.Thread(target=work, daemon=True).start()

    def _scan_tick(self, mhz, frac):
        self._suppress = True
        self.slider.set_value(mhz)
        self._suppress = False
        self.freq_label.set_text("%.1f" % mhz)
        self.progress.set_fraction(clamp(frac, 0, 1))
        self._set_status("搜台中… %.1f MHz" % mhz)
        return False

    def _scan_verify(self, mhz, idx, total):
        self._suppress = True
        self.slider.set_value(mhz)
        self._suppress = False
        self.freq_label.set_text("%.1f" % mhz)
        self.progress.set_fraction(clamp(0.75 + 0.25 * idx / max(total, 1), 0, 1))
        self._set_status("确认电台… %.1f MHz（%d/%d）" % (mhz, idx + 1, total))
        return False

    def _after_scan(self, stations):
        if self._cancel.is_set():
            return False
        self.scanning = False
        self.progress.hide()
        self.scan_btn.set_sensitive(True)
        self.power_btn.set_sensitive(True)
        self.power_btn.set_label("■ 停止" if self.playing else "▶ 开始收听")
        ctx = self.power_btn.get_style_context()
        ctx.remove_class("play" if self.playing else "stop")
        ctx.add_class("stop" if self.playing else "play")
        self.out_combo.set_sensitive(True)
        self._set_seek_sensitive(True)
        old = self._read_list(STATION_FILE)
        if stations or not old:
            found = len(stations)
            stations = self._merge_scan(stations)
            self._write_list(STATION_FILE, stations)
            self._fill_stations(stations)
        else:
            found = 0
            self._fill_stations(old)
        if found:
            self._set_status("搜到 %d 个台" % found)
        elif old:
            self._set_status("本次没有搜到台，已保留上次结果")
        else:
            self._set_status("没有搜到台，可以再试一次")
        self._set_freq(self.current)
        return False

    def _on_seek(self, direction):
        if self.busy or self.scanning or self._switching:
            return
        if self.rec.running():
            self._set_status("录音中不能搜台，请先停止录音")
            return
        self.scanning = True
        self._cancel.clear()
        self.scan_btn.set_sensitive(False)
        self.power_btn.set_sensitive(True)
        self.power_btn.set_label("■ 停止")
        ctx = self.power_btn.get_style_context()
        ctx.remove_class("play")
        ctx.add_class("stop")
        self.out_combo.set_sensitive(False)
        self._set_seek_sensitive(False)
        self.progress.show()
        self.progress.set_fraction(0)
        word = "向上" if direction > 0 else "向下"
        self._set_status("%s搜台中…" % word)
        start = self.current
        was_playing = self.playing

        def work():
            temporary = self._scan_audio_begin()
            if self._cancel.is_set():
                return
            self.fm.init(rds=False)
            self.fm.audio_on()
            first = int(round(start * 10))
            last = int(FM_MAX * 10) if direction > 0 else int(FM_MIN * 10)
            span = max(abs(last - first), 1)
            hit = None
            step = first + direction
            while (step - last) * direction <= 0:
                if self._cancel.is_set():
                    return
                mhz = step / 10.0
                GLib.idle_add(self._seek_tick, mhz,
                              abs(step - first) / span, word)
                flag, rssi, snr = self.fm.tune_wait(step * 100)
                self.fm.audio_on()
                if (flag is not None and (flag & 3) == 1 and
                        rssi is not None and snr is not None):
                    dbu = self.fm.rssi_dbu(rssi)
                    if dbu >= SCAN_RSSI_MIN and snr >= SCAN_SNR_MIN:
                        GLib.idle_add(self._seek_verify, mhz)
                        flag, rssi, snr = self.fm.tune_wait(step * 100)
                        self.fm.audio_on()
                        if (flag is not None and (flag & 3) == 1 and
                                rssi is not None and snr is not None):
                            dbu = self.fm.rssi_dbu(rssi)
                            if (dbu >= VERIFY_RSSI_MIN and
                                    snr >= VERIFY_SNR_MIN):
                                item = {"mhz": round(mhz, 1),
                                        "rssi": dbu, "snr": snr}
                                hit = item
                                break
                step += direction
            if self._cancel.is_set():
                return
            if hit is None:
                self.fm.write(0x0A, first * 100 - 64000)
                self.fm.raw(0x09, 0x00, 0x01)
                time.sleep(0.35)
            if was_playing:
                self.fm.audio_on()
            else:
                self.fm.off()
            self._scan_audio_end(temporary)
            GLib.idle_add(self._after_seek, hit)

        threading.Thread(target=work, daemon=True).start()

    def _seek_tick(self, mhz, frac, word):
        self._suppress = True
        self.slider.set_value(mhz)
        self._suppress = False
        self.freq_label.set_text("%.1f" % mhz)
        self.progress.set_fraction(clamp(frac, 0, 1))
        self._set_status("%s搜台中… %.1f MHz" % (word, mhz))
        return False

    def _seek_verify(self, mhz):
        self._suppress = True
        self.slider.set_value(mhz)
        self._suppress = False
        self.freq_label.set_text("%.1f" % mhz)
        self.progress.set_fraction(1.0)
        self._set_status("确认电台… %.1f MHz" % mhz)
        return False

    def _after_seek(self, hit):
        if self._cancel.is_set():
            return False
        self.scanning = False
        self.progress.hide()
        self.scan_btn.set_sensitive(True)
        self.power_btn.set_sensitive(True)
        self.power_btn.set_label("■ 停止" if self.playing else "▶ 开始收听")
        ctx = self.power_btn.get_style_context()
        ctx.remove_class("play" if self.playing else "stop")
        ctx.add_class("stop" if self.playing else "play")
        self.out_combo.set_sensitive(True)
        self._set_seek_sensitive(True)
        if hit is None:
            self._set_freq(self.current)
            self._set_status("已到频段尽头，没有找到电台")
            return False
        self._set_freq(hit["mhz"])
        self._record_station(hit)
        extra = " · SNR %d" % hit["snr"] if hit.get("snr") is not None else ""
        self._set_status("搜到电台 %.1f MHz · %d dBuV%s" %
                         (hit["mhz"], int(hit["rssi"]), extra))
        if self.playing:
            self.player.set_volume(self.volume)
        return False

    def _record_station(self, item):
        self._add_history(item["mhz"], item["rssi"])
        key = round(float(item["mhz"]), 1)
        old = self._read_list(STATION_FILE)
        prev = next((s for s in old
                     if round(float(s["mhz"]), 1) == key), None)
        entry = dict(item)
        if prev and prev.get("favorite"):
            entry["favorite"] = True
        stations = [s for s in old
                    if round(float(s["mhz"]), 1) != key]
        stations.append(entry)
        stations = self._sort_stations(stations)
        self._write_list(STATION_FILE, stations)
        self._fill_stations(stations)

    def _toggle_favorite(self, mhz):
        out = []
        for s in self._read_list(STATION_FILE):
            entry = dict(s)
            if abs(float(entry["mhz"]) - mhz) <= 0.05:
                if entry.get("favorite"):
                    entry.pop("favorite", None)
                    if entry.get("stale"):
                        continue
                else:
                    entry["favorite"] = True
                    entry.pop("stale", None)
            out.append(entry)
        out = self._sort_stations(out)
        self._write_list(STATION_FILE, out)
        self._fill_stations(out)
        return out

    def _on_station_row(self, lb, row):
        if getattr(row, "action", None):
            self._set_freq(float(row.mhz), tune=True)

    def _on_clear_history(self, btn):
        self._write_list(HIST_FILE, [])
        self._fill_history([])

    # ---------- recording / playback ----------
    def _rec_at_text(self):
        if self.rec_at and self.rec_at > time.time():
            return datetime.fromtimestamp(self.rec_at).strftime("%H:%M")
        return (datetime.now() + timedelta(minutes=5)).strftime("%H:%M")

    def _rec_schedule_at(self, text):
        """Parse HH:MM into the next occurrence, as a unix timestamp."""
        try:
            hh, mm = [int(x) for x in text.strip().split(":")]
            now = datetime.now()
            at = now.replace(hour=hh, minute=mm, second=0, microsecond=0)
            if at <= now:
                at += timedelta(days=1)
            return at.timestamp()
        except Exception:
            return None

    def _on_rec_minutes(self, spin):
        self.rec_minutes = int(spin.get_value())
        self._save()

    def _on_rec_sched(self, *_a):
        at = self._rec_schedule_at(self.rec_at_entry.get_text())
        if at is None:
            self._set_status("定时格式应为 HH:MM")
            return
        self.rec_at = at
        self._save()
        self._set_status("将在 %s 开始录音 %d 分钟" %
                         (datetime.fromtimestamp(at).strftime("%H:%M"),
                          self.rec_minutes))

    def _on_rec_cancel(self, *_a):
        if self.rec_at is None:
            return
        self.rec_at = None
        self._save()
        self._set_status("已取消定时录音")

    def _on_rec_now(self, *_a):
        if self.rec.running():
            self._stop_recording()
        else:
            self._start_recording(self.rec_minutes)

    def _start_recording(self, minutes):
        if self.rec.running() or self.busy or self.scanning:
            return False
        directory = rec_dir()
        os.makedirs(directory, exist_ok=True)
        stamp = datetime.now().strftime("%Y%m%d_%H%M")
        base = os.path.join(directory, "FM_%s_%.1fMHz_%dmin.wav" %
                            (stamp, self.current, minutes))
        path, n = base, 1
        while os.path.exists(path):
            path = base[:-4] + "_%d.wav" % n
            n += 1
        self.rec_at = None
        self._save()
        self._set_status("正在打开录音…")

        def work():
            with self._audio_lock:
                # recording taps the capture node, so powering the tuner is
                # enough; no loopback and no audible output are required
                if not self.playing:
                    self.fm.init()
                    self.fm.tune(int(round(self.current * 1000)))
                    self._rec_powered = True
                self.rec.begin(path, minutes)
            GLib.idle_add(self._after_rec_start, path, minutes)

        threading.Thread(target=work, daemon=True).start()
        return True

    def _after_rec_start(self, path, minutes):
        if not self.rec.running():
            self.rec.end()
            self.rec_btn.set_label("● 立即录音")
            self._set_status("录音启动失败：%s" % os.path.basename(path))
            return False
        self.rec_btn.set_label("■ 停止录音")
        self._refresh_recordings()
        self._set_status("● 正在录音 %.1f MHz · %d 分钟 · %s" %
                         (self.current, minutes, os.path.basename(path)))
        return False

    def _stop_recording(self, note=None):
        path = self.rec.end()
        if self._rec_powered:
            self._rec_powered = False
            if not self.playing:
                self.player.set_mute(True)
                with self._audio_lock:
                    self.fm.off()
                self.player.set_mute(False)
                self.player.route_off()
        self.rec_btn.set_label("● 立即录音")
        self._refresh_recordings()
        if path and os.path.exists(path):
            self._set_status(note or "录音已保存：%s（%s）" %
                             (os.path.basename(path), fmt_dur(rec_seconds(path))))
        elif note:
            self._set_status(note)

    def _tick_jobs(self):
        if self._shutting_down:
            return False
        now = time.time()
        if self.rec_at and now >= self.rec_at and not self.rec.running():
            if not self.busy and not self.scanning:
                self._start_recording(self.rec_minutes)
        if self.rec.running():
            elapsed = now - self.rec.started
            total = self.rec.minutes * 60
            if elapsed >= total:
                self._stop_recording(note="定时录音已完成（%s）" % fmt_dur(total))
            else:
                self.rec_status.set_text("%s / %s" % (fmt_dur(elapsed),
                                                      fmt_dur(total)))
        elif self.rec.proc is not None:
            self._stop_recording(note="录音已中断")
        else:
            self.rec_status.set_text("")
        if self._play_proc is not None and self._play_proc.poll() is not None:
            self._play_proc = None
            self._play_path = None
            self._refresh_recordings()
            self._set_status("回放结束")
        return True

    def _recordings(self):
        directory = rec_dir()
        try:
            names = [n for n in os.listdir(directory) if n.endswith(".wav")]
        except OSError:
            return []
        paths = [os.path.join(directory, n) for n in names]
        try:
            paths.sort(key=os.path.getmtime, reverse=True)
        except OSError:
            pass
        return paths

    def _refresh_recordings(self):
        if not hasattr(self, "rec_list"):
            return
        for child in self.rec_list.get_children():
            self.rec_list.remove(child)
        paths = self._recordings()
        if not paths:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="还没有录音")
            lbl.get_style_context().add_class("empty")
            lbl.set_margin_top(6)
            lbl.set_margin_bottom(6)
            row.add(lbl)
            self.rec_list.add(row)
        else:
            for path in paths[:40]:
                self.rec_list.add(self._make_rec_row(path))
        self.rec_list.show_all()

    def _make_rec_row(self, path):
        row = Gtk.ListBoxRow()
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.set_margin_top(4)
        box.set_margin_bottom(4)
        name = os.path.basename(path)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label=name)
        title.set_halign(Gtk.Align.START)
        title.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        try:
            nbytes = os.path.getsize(path)
        except OSError:
            nbytes = 0
        meta = Gtk.Label(label="%s · %s" %
                         (fmt_dur(rec_seconds(path)), fmt_size(nbytes)))
        meta.get_style_context().add_class("empty")
        meta.set_halign(Gtk.Align.START)
        text.pack_start(title, False, False, 0)
        text.pack_start(meta, False, False, 0)
        box.pack_start(text, True, True, 0)
        playing = (self._play_path == path and self._play_proc is not None
                   and self._play_proc.poll() is None)
        play = Gtk.Button(label="■" if playing else "▶")
        play.get_style_context().add_class("flat-round")
        play.connect("clicked", self._on_rec_play, path)
        box.pack_start(play, False, False, 0)
        delete = Gtk.Button(label="✕")
        delete.get_style_context().add_class("flat-round")
        delete.connect("clicked", self._on_rec_delete, path)
        box.pack_start(delete, False, False, 0)
        row.add(box)
        return row

    def _on_rec_play(self, _btn, path):
        if self._play_proc is not None and self._play_path == path:
            self._stop_playback()
            self._set_status("回放已停止")
            self._refresh_recordings()
            return
        if self.rec.running():
            self._set_status("录音中不能回放，请先停止录音")
            return
        self._stop_playback()
        if self.playing:
            self._stop_play()
        if not self.player.sink:
            self.player.sink = SINK_LOCAL
        self.player.set_volume(self.volume)
        self._play_proc = subprocess.Popen(
            ["paplay", "--device=" + self.player.sink, path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self._play_path = path
        self._refresh_recordings()
        self._set_status("▶ 回放：%s" % os.path.basename(path))

    def _stop_playback(self):
        proc, self._play_proc = self._play_proc, None
        self._play_path = None
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()

    def _on_rec_delete(self, _btn, path):
        if self.rec.running() and self.rec.path == path:
            self._set_status("正在录制的文件不能删除")
            return
        dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                   message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.OK_CANCEL,
                                   text="删除录音？")
        dialog.format_secondary_text(os.path.basename(path))
        resp = dialog.run()
        dialog.destroy()
        if resp != Gtk.ResponseType.OK:
            return
        if self._play_path == path:
            self._stop_playback()
        try:
            os.remove(path)
            self._set_status("已删除 %s" % os.path.basename(path))
        except OSError as exc:
            self._set_status("删除失败：%s" % exc)
        self._refresh_recordings()

    def _on_volume(self, scale):
        if self._vol_suppress:
            return
        self.volume = int(scale.get_value())
        self.player.set_volume(self.volume)
        self._save()

    def control_command(self, cmd):
        parts = cmd.split()
        if not parts:
            return {"ok": False, "error": "empty"}
        c = parts[0]
        try:
            if c == "status":
                spec = None
                if self.spec is not None:
                    spec = [round(max(self.spec.bars), 3),
                            round(sum(self.spec.bars), 2)]
                return {"ok": True, "playing": self.playing,
                        "freq": self.current, "display": self.freq_label.get_text(),
                        "volume": self.volume,
                        "output": self.output,
                        "output_label": self._output_label(self.output),
                        "outputs": [{"id": t, "label": l} for t, l in list_outputs()],
                        "jack": jack_state(),
                        "busy": self.busy, "scanning": self.scanning,
                        "recording": self.rec.running(),
                        "rec_path": self.rec.path,
                        "rec_minutes": self.rec.minutes if self.rec.running()
                        else self.rec_minutes,
                        "rec_elapsed": int(time.time() - self.rec.started)
                        if self.rec.running() else 0,
                        "rec_at": self.rec_at,
                        "playing_back": self._play_path,
                        "spec": spec, "status": self.status_label.get_text(),
                        "stations": self._sort_stations(
                            self._read_list(STATION_FILE))}
            if c == "outputs":
                return {"ok": True, "current": self.output,
                        "outputs": [{"id": t, "label": l} for t, l in list_outputs()]}
            if c == "output" and len(parts) > 1:
                target = parts[1]
                ids = [t for t, _ in list_outputs()]
                if target not in ids:
                    return {"ok": False, "error": "unknown output", "outputs": ids}
                if self.scanning or self._switching:
                    return {"ok": False, "error": "busy scanning"}
                if self.playing:
                    if self._switching:
                        return {"ok": False, "error": "busy switching"}
                    if target != self.output:
                        self._start_output_switch(target)
                else:
                    self.output = target
                    self._out_suppress = True
                    self.out_combo.set_active_id(target)
                    self._out_suppress = False
                    self.player.sink = sink_for(target)
                    self.player.own_default_sink(self.player.sink)
                    self.player.set_volume(self.volume)
                    self._save()
                return {"ok": True, "output": target}
            if c == "start":
                if not self.playing and not self.busy:
                    self._start_play()
                return {"ok": True}
            if c == "scan":
                if not self.scanning and not self.busy:
                    self._on_scan(None)
                return {"ok": True}
            if c == "seek" and len(parts) > 1 and parts[1] in ("up", "down"):
                if self.busy or self.scanning:
                    return {"ok": False, "error": "busy"}
                self._on_seek(1 if parts[1] == "up" else -1)
                return {"ok": True, "direction": parts[1]}
            if c == "stop":
                if self.scanning:
                    self._cancel_activity()
                elif self.playing:
                    self._stop_play()
                return {"ok": True}
            if c == "tune" and len(parts) > 1:
                self._set_freq(float(parts[1]), tune=True)
                return {"ok": True}
            if c == "favorite" and len(parts) > 1:
                stations = self._toggle_favorite(float(parts[1]))
                return {"ok": True, "stations": stations}
            if c == "volume" and len(parts) > 1:
                self.vol_slider.set_value(float(parts[1]))
                return {"ok": True}
            if c == "record":
                sub = parts[1] if len(parts) > 1 else ""
                if sub == "start":
                    mins = self.rec_minutes
                    if len(parts) > 2:
                        try:
                            mins = clamp(int(parts[2]), REC_MIN, REC_MAX)
                        except ValueError:
                            return {"ok": False, "error": "minutes"}
                    ok = self._start_recording(mins)
                    return {"ok": ok, "minutes": mins,
                            "error": None if ok else "busy"}
                if sub == "stop":
                    self._stop_recording()
                    return {"ok": True}
                if sub == "at" and len(parts) > 2:
                    at = self._rec_schedule_at(parts[2])
                    if at is None:
                        return {"ok": False, "error": "HH:MM"}
                    self.rec_at = at
                    self._save()
                    return {"ok": True, "at": at,
                            "human": datetime.fromtimestamp(at).isoformat(timespec="minutes")}
                if sub == "cancel":
                    self.rec_at = None
                    self._save()
                    return {"ok": True}
                return {"ok": True, "recording": self.rec.running(),
                        "path": self.rec.path,
                        "minutes": self.rec.minutes if self.rec.running()
                        else self.rec_minutes,
                        "elapsed": int(time.time() - self.rec.started)
                        if self.rec.running() else 0,
                        "scheduled": self.rec_at}
            if c == "recordings":
                items = []
                for i, path in enumerate(self._recordings()):
                    try:
                        size = os.path.getsize(path)
                        mtime = int(os.path.getmtime(path))
                    except OSError:
                        size, mtime = 0, 0
                    items.append({"index": i, "name": os.path.basename(path),
                                  "path": path, "seconds": rec_seconds(path),
                                  "bytes": size, "mtime": mtime,
                                  "playing": self._play_path == path})
                return {"ok": True, "dir": rec_dir(), "items": items,
                        "recording": self.rec.running()}
            if c == "play" and len(parts) > 1:
                if parts[1] == "stop":
                    self._stop_playback()
                    self._refresh_recordings()
                    return {"ok": True}
                paths = self._recordings()
                target = None
                if parts[1].isdigit() and int(parts[1]) < len(paths):
                    target = paths[int(parts[1])]
                else:
                    for path in paths:
                        if os.path.basename(path) == parts[1] or path == parts[1]:
                            target = path
                            break
                if target is None:
                    return {"ok": False, "error": "not found"}
                self._on_rec_play(None, target)
                return {"ok": True, "playing": self._play_path}
            if c == "style":
                def info(w):
                    ctx = w.get_style_context()
                    fg = ctx.get_color(Gtk.StateFlags.NORMAL)
                    bg = ctx.get_background_color(Gtk.StateFlags.NORMAL)
                    hx = lambda v: "%02x" % int(round(v * 255))
                    return {"fg": "#" + hx(fg.red) + hx(fg.green) + hx(fg.blue),
                            "bg": "#" + hx(bg.red) + hx(bg.green) + hx(bg.blue)}
                return {"ok": True, "power": info(self.power_btn),
                        "scan": info(self.scan_btn),
                        "status": info(self.status_label),
                        "freq": info(self.freq_label)}
            if c == "layout":
                def box(w):
                    a = w.get_allocation()
                    return [a.x, a.y, a.width, a.height]
                return {"ok": True,
                        "window": box(self),
                        "left": box(self.left_scroll),
                        "right": box(self.right_box),
                        "stations": box(self.station_scroll),
                        "history": box(self.hist_scroll),
                        "spectrum": box(self.area),
                        "paned": self.paned.get_position()}
            if c == "shot" and len(parts) > 1:
                win = self.get_window()
                if win is None:
                    return {"ok": False, "error": "no window"}
                try:
                    pb = Gdk.pixbuf_get_from_window(
                        win, 0, 0, win.get_width(), win.get_height())
                except Exception as e:
                    return {"ok": False, "error": str(e)}
                if pb is None:
                    return {"ok": False, "error": "backend does not allow window capture"}
                pb.savev(parts[1], "png", [], [])
                return {"ok": True, "path": parts[1],
                        "width": pb.get_width(), "height": pb.get_height()}
            if c == "snapshot" and len(parts) > 1:
                if self.spec_pixbuf is None:
                    return {"ok": False, "error": "no pixbuf yet"}
                self.spec_pixbuf.savev(parts[1], "png", [], [])
                return {"ok": True, "path": parts[1],
                        "width": self.spec_pixbuf.get_width(),
                        "height": self.spec_pixbuf.get_height()}
            if c == "quit":
                GLib.idle_add(self._quit_now)
                return {"ok": True}
        except Exception as e:
            return {"ok": False, "error": str(e)}
        return {"ok": False, "error": "unknown command"}

    def _quit_now(self):
        self._on_delete()
        return False

    def _on_delete(self, *args):
        try:
            self._stop_playback()
            if self.rec.running():
                self.rec.end()
        except Exception:
            pass
        self._save()
        self._shutting_down = True
        self._cancel.set()
        self.scanning = False
        self.playing = False
        try:
            self.player.set_mute(True)
            # a scan worker may be between prepare() and loopback_on();
            # unload a few times so nothing is left behind
            for _ in range(3):
                self.player.loopback_off()
                self.fm.off()
                time.sleep(0.1)
            self.player.route_off()
        except Exception:
            pass
        self._clear_active()
        if self.control:
            self.control.close()
        Gtk.main_quit()
        return False


def main():
    app = App()
    app.show_all()
    app.progress.hide()
    app._render_spectrum()
    Gtk.main()


if __name__ == "__main__":
    main()
