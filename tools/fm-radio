def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def pactl(*args, timeout=10):
    try:
        return subprocess.run(["pactl"] + list(args), capture_output=True,
                              text=True, timeout=timeout)
    except Exception:
        return None


def list_sinks():
    """sink node name -> (description, bluez profile), in pactl order."""
    r = pactl("list", "sinks")
    out = {}
    cur = None
    for line in (r.stdout if r else "").splitlines():
        s = line.strip()
        if s.startswith("Name: "):
            cur = s[6:]
            out[cur] = [cur, ""]
        elif s.startswith("Description: ") and cur:
            out[cur][0] = s[13:]
        elif s.startswith("api.bluez5.profile = ") and cur:
            q = s.split("=", 1)[1].strip().strip('"')
            out[cur][1] = q
    return {k: tuple(v) for k, v in out.items()}


def _is_hfp_sink(name, profile):
    """Hands-free (SCO/mono) sink node, not the music profile.

    On this board the SCO node reuses the A2DP node name and only differs in
    the bluez profile property, so trust the profile when pactl reports one.
    """
    if profile:
        return not profile.startswith("a2dp")
    low = name.lower()
    return "head-unit" in low or "headset-hf" in low or "hands-free" in low


def list_outputs():
    """[(target_id, label)] offered by the output selector.

    A dual-profile headset exposes a hands-free sink as well as its A2DP one
    while the card profile is changing. Radio only wants the music profile, so
    a hands-free node is hidden as long as the same device has an A2DP one.
    """
    sinks = list_sinks()
    out = [("speaker", "喇叭"), ("headphones", "有线耳机")]
    bt = [(n, d, p) for n, (d, p) in sinks.items() if n.startswith(BT_PREFIX)]
    a2dp = [(n, d) for n, d, p in bt if not _is_hfp_sink(n, p)]
    for name, desc in (a2dp or [(n, d) for n, d, p in bt]):
        label = "蓝牙 · " + desc
        if not a2dp:
            label += "（免提·单声道）"
        out.append((name, label))
    return out


def local_sink():
    """Live name of the board's analog sink, or None.

    Speaker and headphones share this one node; the jack decides which device
    the codec feeds, so the name must be read instead of hardcoded.
    """
    for name in list_sinks():
        if name.startswith(LOCAL_PREFIX):
            return name
    return None


def jack_state():
    """True if the headphone plug is in (used as FM antenna), None if unknown."""
    try:
        r = subprocess.run(["amixer", "-c", "0", "controls"],
                           capture_output=True, text=True, timeout=10)
        m = re.search(r"numid=(\d+),.*Headphone Jack", r.stdout or "")
        if not m:
            return None
        r = subprocess.run(["amixer", "-c", "0", "cget", "numid=" + m.group(1)],
                           capture_output=True, text=True, timeout=10)
        return (r.stdout or "").strip().endswith("values=on")
    except Exception:
        return None


def fm_source_present():
    """True when the tuner's source node is in the graph.

    pw-record does not fail when --target is missing: WirePlumber quietly
    falls back to the default source, which is the internal microphone. In a
    player that becomes a microphone-to-speaker loop, so never start a stream
    against a source that is not there.
    """
    try:
        out = subprocess.run(["pw-dump"], capture_output=True, text=True,
                             timeout=10).stdout
        dump = json.loads(out)
    except Exception:
        return False
    for obj in dump:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = (obj.get("info") or {}).get("props") or {}
        if props.get("node.name") == FM_SOURCE:
            return True
    return False


def rec_dir():
    base = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_MUSIC)
    if not base:
        base = os.path.join(os.path.expanduser("~"), "Music")
    return os.path.join(base, "fm-radio")


def rec_seconds(path):
    """Duration of a recording, from its WAV payload size."""
    try:
        return max(0, (os.path.getsize(path) - 44) // (REC_RATE * REC_CHANNELS * 2))
    except OSError:
        return 0


def fmt_dur(seconds):
    seconds = max(0, int(seconds))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    return "%d:%02d:%02d" % (h, m, s) if h else "%02d:%02d" % (m, s)


def fmt_size(nbytes):
    if nbytes >= 1024 ** 3:
        return "%.2f GB" % (nbytes / 1024.0 ** 3)
    if nbytes >= 1024 ** 2:
        return "%.1f MB" % (nbytes / 1024.0 ** 2)
    return "%d KB" % max(1, nbytes // 1024)


class FMChip:
    """Client for the fm-tuner service.

    The chip is a system-layer resource: the service owns the HCI power-up
    sequence, keeps the "fm_radio" PipeWire source alive and serializes access.
    Requests are one JSON object per connection.
    """

    def __init__(self):
        self.lock = threading.Lock()

    def _call(self, cmd, sock_timeout=25, **kw):
        req = {"cmd": cmd}
        req.update(kw)
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(sock_timeout)
            s.connect(TUNER_SOCK)
            s.sendall((json.dumps(req) + "\n").encode())
            buf = b""
            while not buf.endswith(b"\n"):
                d = s.recv(65536)
                if not d:
                    break
                buf += d
            s.close()
            rep = json.loads(buf.decode() or "{}")
        except Exception:
            return None
        return rep.get("result") if rep.get("ok") else None

    def write(self, reg, val):
        return self._call("write", reg=int(reg), val=int(val)) is True

    def raw(self, *data):
        return self._call("raw", data=[int(d) for d in data]) is True

    def vsc(self, *data):
        return self._call("vsc", data=[int(d) for d in data]) is True

    def read(self, reg, n=1):
        v = self._call("read", reg=int(reg), n=int(n))
        return v if isinstance(v, int) else None

    def init(self, rds=False):
        return self._call("init", sock_timeout=40, rds=bool(rds)) is True

    def off(self):
        self._call("off")

    def tune(self, khz, settle=0.85):
        r = self._call("tune", sock_timeout=40, khz=int(khz),
                       settle=round(float(settle), 3))
        return tuple(r) if isinstance(r, list) and len(r) == 3 else (None, None, None)

    def audio_on(self):
        self._call("audio_on")

    def tune_wait(self, khz, timeout=0.8, settle=0.25):
        """Tune and wait for usable signal meters.

        The tune flag can still carry the previous result right after a
        retune, and SNR needs about 0.2 s to reach its final value: reading
        the meters the moment the flag turns 1 reports the old channel or a
        transient value (e.g. 8 dB instead of 12 dB on a strong station).
        """
        r = self._call("tune_wait", sock_timeout=40, khz=int(khz),
                       timeout=float(timeout), settle=float(settle))
        return tuple(r) if isinstance(r, list) and len(r) == 3 else (None, None, None)

    def status(self):
        rep = self._call("status")
        if not isinstance(rep, dict):
            return None, None, None
        return rep.get("flag"), rep.get("rssi"), rep.get("snr")

    @staticmethod
    def rssi_dbu(raw):
        # BCM: 0x80+n means n dBuV; values below 0x80 carry no signal
        if raw is None or raw < 0x80:
            return 0
        return raw & 0x7F

    def read_rds(self):
        """Read the RDS FIFO; returns [(block, value, valid), ...]."""
        out = self._call("read_raw", reg=0x80, n=64)
        if not out:
            return []
        try:
            data = [int(h, 16) for h in out]
        except ValueError:
            return []
        tuples = []
        for i in range(0, len(data) - 2, 3):
            meta, msb, lsb = data[i], data[i + 1], data[i + 2]
            if (meta, msb, lsb) == (0x7C, 0xFF, 0xFF):
                break
            tuples.append((meta & 0x07, (msb << 8) | lsb,
                           not (meta & 0x80)))
        return tuples

    def rds_flush(self):
        self.raw(0x02, 0x00, 0x02)
        self.raw(0x02, 0x00, 0x00)


class RDSText:
    """Accumulates RDS groups (PS name, radio text, PI, PTY)."""

    def __init__(self):
        self.pi = None
        self.pty = None
        self.ps = [" "] * 8
        self.rt = [" "] * 64
        self.group = None
        self.spare = 0
        self.c_bytes = None

    def feed(self, tuples):
        for block, val, valid in tuples:
            if not valid:
                continue
            msb, lsb = val >> 8, val & 0xFF
            if block == 0:
                self.pi = val
            elif block == 1:
                self.group = (msb >> 3) & 0x1F
                self.spare = lsb & 0x1F
                self.pty = ((msb << 3) & 0x18) | ((lsb >> 5) & 0x07)
            elif block == 2:
                self.c_bytes = (msb, lsb)
            elif block == 3 and self.group is not None:
                if self.group in (0, 1):
                    i = 2 * (self.spare & 0x03)
                    self.ps[i:i + 2] = [chr(msb), chr(lsb)]
                elif self.group == 4 and self.c_bytes:
                    i = 4 * (self.spare & 0x0F)
                    self.rt[i:i + 4] = [chr(self.c_bytes[0]), chr(self.c_bytes[1]),
                                        chr(msb), chr(lsb)]

    @staticmethod
    def _clean(chars):
        return "".join(c if 32 <= ord(c) < 127 else " " for c in chars).strip()

    def ps_name(self):
        s = self._clean(self.ps)
        return s if len(s) >= 2 else ""

    def radio_text(self):
        return self._clean(self.rt)


class FmStream:
    """The one reader of the BT-FM capture, shared by playback, recording and
    the spectrum.

    PCM 5 takes a single reader, so the first consumer to attach opens it and
    the last one to leave closes it. Callbacks run on the pump thread; anything
    that could block has to queue instead of stalling everybody.
    """

    CHUNK = 8192

    def __init__(self):
        self.proc = None
        self.errf = None
        self.thread = None
        self.holders = set()
        self.subs = []
        self.lock = threading.Lock()

    def running(self):
        return self.proc is not None and self.proc.poll() is None

    def attach(self, key, cb, hold=True):
        with self.lock:
            if hold:
                self.holders.add(key)
            if all(k != key for k, _ in self.subs):
                self.subs.append((key, cb))
            # a watcher rides along with somebody's stream, it never opens one
            piggy = hold or bool(self.holders)
        if not piggy:
            return True
        if not self._start():
            self.detach(key)
            return False
        return True

    def detach(self, key):
        with self.lock:
            self.subs = [(k, cb) for k, cb in self.subs if k != key]
            self.holders.discard(key)
            idle = not self.holders
        if idle:
            self._stop()

    def _start(self):
        with self.lock:
            if self.running():
                return True
            if self.thread is not None and self.thread.is_alive():
                return False
            if not fm_source_present():
                return False
            try:
                self.errf = open("/tmp/fm-radio-capture.err", "wb")
                self.proc = subprocess.Popen(
                    ["pw-record", "--target", FM_SOURCE,
                     "--rate", str(REC_RATE), "--channels", str(REC_CHANNELS),
                     "--format", "s16", "--media-category", "Capture", "-"],
                    stdout=subprocess.PIPE, stderr=self.errf)
            except Exception:
                self.proc = None
                return False
            # pw-record exiting is not the only failure: it keeps running when
            # the target is gone, so check the node again once the stream has
            # had time to link.
            time.sleep(0.3)
            if self.proc.poll() is not None or not fm_source_present():
                self.proc.terminate()
                self.proc = None
                return False
            self.thread = threading.Thread(target=self._pump, daemon=True)
            self.thread.start()
            return True

    def _stop(self):
        p, self.proc = self.proc, None
        t, self.thread = self.thread, None
        if p is not None and p.poll() is None:
            p.terminate()
            try:
                p.wait(timeout=3)
            except subprocess.TimeoutExpired:
                p.kill()
        if t is not None and t.is_alive():
            t.join(timeout=3)
        f, self.errf = self.errf, None
        if f is not None:
            try:
                f.close()
            except Exception:
                pass

    def _pump(self):
        frame = 2 * REC_CHANNELS
        chunk = self.CHUNK - (self.CHUNK % frame)
        proc = self.proc
        while True:
            try:
                data = proc.stdout.read(chunk)
            except Exception:
                break
            if not data:
                break
            with self.lock:
                subs = list(self.subs)
            for _, cb in subs:
                try:
                    cb(data)
                except Exception:
                    pass
        with self.lock:
            if self.proc is proc:
                self.proc = None
                self.thread = None


STREAM = FmStream()


class Player:
    PLAY_CHUNKS = 64

    def __init__(self):
        self.sink = local_sink()
        self.target = "headphones"
        self.play_proc = None
        self.play_thread = None
        self.play_q = None

    def _sinks(self):
        return list_sinks()

    def _card_profile(self, card):
        r = pactl("list", "cards")
        inside = False
        for line in (r.stdout if r else "").splitlines():
            s = line.strip()
            if s.startswith("Name: "):
                inside = (s[6:] == card)
            elif inside and s.startswith("Active Profile:"):
                return s.split(":", 1)[1].strip()
        return None

    def _card_profiles(self, card):
        r = pactl("list", "cards")
        out = []
        inside = False
        listing = False
        for line in (r.stdout if r else "").splitlines():
            s = line.strip()
            if s.startswith("Name: "):
                inside = (s[6:] == card)
                listing = False
            elif inside and s == "Profiles:":
                listing = True
            elif inside and listing:
                if s.startswith("Active Profile:") or s.startswith("Ports:"):
                    break
                if ": " in s:
                    out.append(s.split(": ", 1)[0])
        return out

    def _ensure_profile(self, target):
        """Switch the card to the profile whose output is the wanted one.

        Under UCM every output device is its own profile, so speaker vs
        headphones is a card-profile choice. The codec routing is done by the
        UCM device sequences; this program only selects.
        """
        want = "Speaker" if target == "speaker" else "Headphones"
        current = self._card_profile(CARD) or ""
        cur_in = "HeadsetMic" if "HeadsetMic" in current else "IntMic"
        profiles = [p for p in self._card_profiles(CARD)
                    if p.startswith("HiFi") and want in p]
        same_in = [p for p in profiles if cur_in in p]
        chosen = (same_in or profiles or [None])[0]
        if chosen is None:
            return None
        if current != chosen:
            pactl("set-card-profile", CARD, chosen)
        for _ in range(40):
            sink = local_sink()
            if sink and want in sink:
                return sink
            time.sleep(0.1)
        return None

    @staticmethod
    def _bt_card(sink):
        mac = sink[len(BT_PREFIX):].rsplit(".", 1)[0]
        return "bluez_card." + mac

    def _resolve_bt_sink(self, sink):
        mac = sink[len(BT_PREFIX):].rsplit(".", 1)[0]
        sinks = self._sinks()
        if sink in sinks:
            return sink
        for name in sinks:
            if name.startswith(BT_PREFIX + mac + "."):
                return name
        return sink

    def own_default_sink(self, sink):
        """Keep the system default on the sink FM plays to.

        GNOME's slider and the media keys act on the default sink. When it
        differs from ours, the two volume controls silently diverge: raising
        the system volume feeds another device and what is being heard stays
        where it was.
        """
        if not sink:
            return
        r = pactl("get-default-sink")
        if r and r.returncode == 0 and (r.stdout or "").strip() == sink:
            return
        pactl("set-default-sink", sink)

    def prepare(self, target):
        """Make the wanted output usable for FM; returns the sink target or None.

        Speaker and headphones are the same PipeWire sink, but not the same
        analog path: the codec drives HPO for headphones and AIF2/TFA9890 for
        the speakers, and the plug stays in as the antenna.
        """
        if target in ("headphones", "speaker"):
            sink = self._ensure_profile(target)
            if not sink:
                return None
            self.sink = sink
            self.target = target
            self.own_default_sink(sink)
            return target
        if target.startswith(BT_PREFIX):
            sink = self._resolve_bt_sink(target)
            card = self._bt_card(sink)
            profile = self._card_profile(card) or ""
            if not profile.startswith("a2dp"):
                pactl("set-card-profile", card, "a2dp-sink")
                for _ in range(50):
                    profile = self._card_profile(card) or ""
                    sink = self._resolve_bt_sink(target)
                    if profile.startswith("a2dp") and sink in self._sinks():
                        break
                    time.sleep(0.1)
            if not profile.startswith("a2dp") or sink not in self._sinks():
                return None
            # WirePlumber restores the route volume right after the profile lands
            time.sleep(0.3)
            self.sink = sink
            self.own_default_sink(sink)
            return sink
        return None

    def set_volume(self, pct):
        if not self.sink:
            return
        pactl("set-sink-volume", self.sink, "%d%%" % int(pct))
        pactl("set-sink-mute", self.sink, "0")

    def get_volume(self):
        """Volume percent of the sink we route to, or None."""
        if not self.sink:
            return None
        r = pactl("get-sink-volume", self.sink)
        if not r or r.returncode != 0:
            return None
        m = re.search(r"(\d+)%", r.stdout or "")
        return int(m.group(1)) if m else None

    def set_mute(self, muted):
        if self.sink:
            pactl("set-sink-mute", self.sink, "1" if muted else "0")

    def _sink_index(self, sink):
        r = pactl("list", "short", "sinks")
        for line in (r.stdout if r else "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == sink:
                return parts[0]
        return None

    def _has_sink_input(self, idx):
        r = pactl("list", "short", "sink-inputs")
        for line in (r.stdout if r else "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == idx:
                return True
        return False

    def _sink_state(self, sink):
        r = pactl("list", "short", "sinks")
        for line in (r.stdout if r else "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == sink:
                return parts[-1]
        return None

    def _feed_playback(self, chunk):
        """Called on the pump thread: never block it, drop instead.

        Radio has no use for a backlog - if the sink stalls, the newest audio
        is the one worth keeping.
        """
        q = self.play_q
        if q is None:
            return
        try:
            q.put_nowait(chunk)
        except queue.Full:
            try:
                q.get_nowait()
                q.put_nowait(chunk)
            except (queue.Empty, queue.Full):
                pass

    def _drain_playback(self):
        q, proc = self.play_q, self.play_proc
        while True:
            try:
                chunk = q.get(timeout=5)
            except queue.Empty:
                continue
            if chunk is None:
                break
            try:
                proc.stdin.write(chunk)
                proc.stdin.flush()
            except Exception:
                break

    def loopback_on(self):
        self.loopback_off()
        if not self.sink or not STREAM.attach("play", self._feed_playback):
            return None
        # aplay binds to whatever is the default the moment it opens
        self.own_default_sink(self.sink)
        try:
            self.play_proc = subprocess.Popen(
                ["aplay", "-D", "default", "-q", "-f", "S16_LE",
                 "-c", str(REC_CHANNELS), "-r", str(REC_RATE), "-"],
                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL)
        except Exception:
            self.play_proc = None
            STREAM.detach("play")
            return None
        self.play_q = queue.Queue(maxsize=self.PLAY_CHUNKS)
        self.play_thread = threading.Thread(target=self._drain_playback,
                                            daemon=True)
        self.play_thread.start()
        # A pipewire client only appears as a sink-input once audio flows, so
        # an empty list here is not proof of failure - it is exactly what a
        # dead capture stream looks like. Judge by the processes, and take the
        # node as confirmation when it does show up.
        for _ in range(20):
            time.sleep(0.15)
            if self.play_proc.poll() is not None or not STREAM.running():
                break
            idx = self._sink_index(self.sink)
            if idx and self._has_sink_input(idx):
                return "fm-pipe"
        if self.play_proc.poll() is None and STREAM.running():
            return "fm-pipe"
        self.loopback_off()
        return None

    def refresh_local_sink(self):
        """Re-resolve the board sink after a jack change swapped UCM devices."""
        if self.sink and self.sink.startswith(LOCAL_PREFIX):
            live = local_sink()
            if live and live != self.sink:
                self.sink = live
        return self.sink

    def loopback_alive(self):
        self.refresh_local_sink()
        if self.play_proc is None or not STREAM.running():
            return False
        if self.play_proc.poll() is not None:
            return False
        if not fm_source_present():
            return False
        state = self._sink_state(self.sink)
        if self.sink.startswith(BT_PREFIX) and state == "SUSPENDED":
            return False
        idx = self._sink_index(self.sink)
        return idx is not None and self._has_sink_input(idx)

    def loopback_off(self):
        q, self.play_q = self.play_q, None
        t, self.play_thread = self.play_thread, None
        p, self.play_proc = self.play_proc, None
        if q is not None:
            try:
                q.put_nowait(None)
            except queue.Full:
                pass
        if t is not None and t.is_alive():
            t.join(timeout=2)
        if p is not None:
            try:
                if p.stdin:
                    p.stdin.close()
            except Exception:
                pass
            if p.poll() is None:
                p.terminate()
                try:
                    p.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    p.kill()
        STREAM.detach("play")


class Recorder:
    """Capture the FM stream to a WAV file straight off the ALSA reader.

    Recording taps the stream, not the output routing: it keeps running while
    the radio is muted, routed to Bluetooth, or not being listened to at all.
    """

    def __init__(self):
        self.wav = None
        self.path = None
        self.started = 0.0
        self.minutes = 0

    def running(self):
        return self.wav is not None and STREAM.running()

    def _write(self, chunk):
        self.wav.writeframesraw(chunk)

    def begin(self, path, minutes):
        try:
            w = wave.open(path, "wb")
        except Exception:
            return
        w.setnchannels(REC_CHANNELS)
        w.setsampwidth(2)
        w.setframerate(REC_RATE)
        if not STREAM.attach("rec", self._write):
            w.close()
            return
        self.wav = w
        self.path = path
        self.started = time.time()
        self.minutes = minutes

    def end(self):
        w, self.wav = self.wav, None
        path, self.path = self.path, None
        if w is not None:
            try:
                w.close()
            except Exception:
                pass
        STREAM.detach("rec")
        return path


class Spectrum(threading.Thread):
    N = 1024
    BANDS = 46
    FMIN, FMAX = 60.0, 18000.0

    def __init__(self):
        super().__init__(daemon=True)
        self.key = "spectrum-%d" % id(self)
        self.buf = bytearray()
        self.lock = threading.Lock()
        self.bars = [0.0] * self.BANDS
        self._rev, self._tw = self._tables()
        self._edges = [self.FMIN * (self.FMAX / self.FMIN) ** (i / self.BANDS)
                       for i in range(self.BANDS + 1)]

    def _tables(self):
        n = self.N
        levels = n.bit_length() - 1
        rev = [int(format(i, "0%db" % levels)[::-1], 2) for i in range(n)]
        tw = [complex(math.cos(-2 * math.pi * k / n),
                      math.sin(-2 * math.pi * k / n)) for k in range(n // 2)]
        return rev, tw

    def _fft(self, x):
        n = self.N
        rev, tw = self._rev, self._tw
        a = [x[rev[i]] for i in range(n)]
        size = 2
        while size <= n:
            half = size // 2
            step = n // size
            for start in range(0, n, size):
                for k in range(half):
                    w = tw[k * step]
                    u = a[start + k]
                    v = a[start + k + half] * w
                    a[start + k] = u + v
                    a[start + k + half] = u - v
            size *= 2
        return a

    def run(self):
        STREAM.attach(self.key, self._feed, hold=False)

    def _feed(self, chunk):
        if REC_CHANNELS > 1:
            samples = array.array("h")
            samples.frombytes(chunk)
            # the tuner is mono, the FW only copies it into both slots
            chunk = samples[0::REC_CHANNELS].tobytes()
        with self.lock:
            self.buf.extend(chunk)
            if len(self.buf) > self.N * 16:
                del self.buf[:-self.N * 16]

    def stop(self):
        STREAM.detach(self.key)

    def update(self):
        with self.lock:
            if len(self.buf) < self.N * 2:
                return False
            raw = bytes(self.buf[-self.N * 2:])
        samples = array.array("h")
        samples.frombytes(raw)
        mean = sum(samples) / float(self.N)
        x = [((samples[i] - mean) / 32768.0)
             * (0.5 - 0.5 * math.cos(2 * math.pi * i / (self.N - 1)))
             for i in range(self.N)]
        spec = self._fft(x)
        mags = [abs(spec[i]) / (self.N / 2.0) for i in range(self.N // 2)]
        bin_hz = 48000.0 / self.N
        out = []
        for b in range(self.BANDS):
            lo = int(self._edges[b] / bin_hz)
            hi = max(lo + 1, int(self._edges[b + 1] / bin_hz))
            peak = max(mags[lo:hi]) if hi <= len(mags) else 0.0
            db = 20 * math.log10(peak + 1e-9)
            # FM demod noise sits around -85 dB, strong stations near -60 dB
            out.append(clamp((db + 95) / 50, 0.0, 1.0))
        for i, v in enumerate(out):
            self.bars[i] = max(v, self.bars[i] * 0.80)
        return True


class Control:
    """Tiny opt-in unix-socket control channel for testing/automation."""

    def __init__(self, app, path):
        import socket
        self.app = app
        self.path = path
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        self.sock.bind(path)
        self.sock.listen(4)
        self.sock.setblocking(False)
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self._readable)

    def _readable(self, fd, cond):
        try:
            conn, _ = self.sock.accept()
        except BlockingIOError:
            return True
        conn.settimeout(2)
        data = b""
        try:
            while not data.endswith(b"\n"):
                chunk = conn.recv(1024)
                if not chunk:
                    break
                data += chunk
            resp = self.app.control_command(data.decode().strip())
            conn.sendall((json.dumps(resp) + "\n").encode())
        except Exception as e:
            try:
                conn.sendall((json.dumps({"ok": False, "error": str(e)}) + "\n").encode())
            except Exception:
                pass
        finally:
            conn.close()
        return True

    def close(self):
        try:
            self.sock.close()
            os.unlink(self.path)
        except Exception:
            pass


