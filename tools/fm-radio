    def _load_lists(self):
        self._fill_stations(self._read_list(STATION_FILE))
        self._fill_history(self._read_list(HIST_FILE))

    @staticmethod
    def _sort_stations(stations):
        # favorites pinned first, then ascending frequency
        return sorted(stations, key=lambda s: (
            0 if s.get("favorite") else 1,
            float(s.get("mhz", 0)),
        ))

    def _merge_scan(self, found):
        old = self._read_list(STATION_FILE)
        old_by_mhz = {round(float(s["mhz"]), 1): s for s in old}
        merged = []
        seen = set()
        for s in found:
            key = round(float(s["mhz"]), 1)
            entry = dict(s)
            prev = old_by_mhz.get(key)
            if prev and prev.get("favorite"):
                entry["favorite"] = True
            merged.append(entry)
            seen.add(key)
        # keep favorites that were not heard this time
        for key, prev in old_by_mhz.items():
            if key in seen or not prev.get("favorite"):
                continue
            entry = dict(prev)
            entry["stale"] = True
            merged.append(entry)
        return self._sort_stations(merged)

    def _fill_stations(self, stations):
        stations = self._sort_stations(stations)
        for child in self.station_list.get_children():
            self.station_list.remove(child)
        if stations:
            favs = sum(1 for s in stations if s.get("favorite"))
            text = "%d 个" % len(stations)
            if favs:
                text += " · %d 收藏" % favs
            self.station_count.set_text(text)
        else:
            self.station_count.set_text("")
        if not stations:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="还没有搜台结果，点右上角“搜台”")
            lbl.get_style_context().add_class("empty")
            lbl.set_margin_top(8)
            lbl.set_margin_bottom(8)
            row.add(lbl)
            row.action = None
            self.station_list.add(row)
        else:
            for s in stations:
                mhz = float(s["mhz"])
                if s.get("stale"):
                    sub = "收藏 · 本次未搜到"
                else:
                    sub = "信号 %d" % int(s.get("rssi", 0))
                    if s.get("snr") is not None:
                        sub += " · SNR %d" % int(s["snr"])
                if s.get("rt"):
                    sub += " · " + str(s["rt"])[:24]
                self.station_list.add(self._make_row(
                    mhz, sub, True, s.get("name", ""),
                    fav=bool(s.get("favorite")),
                    on_fav=lambda m=mhz: self._toggle_favorite(m)))
        self.station_list.show_all()

    def _fill_history(self, items):
        for child in self.hist_list.get_children():
            self.hist_list.remove(child)
        if not items:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="调过的台会出现在这里")
            lbl.get_style_context().add_class("empty")
            lbl.set_margin_top(8)
            lbl.set_margin_bottom(8)
            row.add(lbl)
            row.action = None
            self.hist_list.add(row)
        else:
            for it in items:
                sub = "%s · %d dBuV" % (it.get("ts", ""), int(it.get("rssi", 0)))
                self.hist_list.add(self._make_row(float(it["mhz"]), sub, True))
        self.hist_list.show_all()

    def _add_history(self, mhz, rssi):
        items = [i for i in self._read_list(HIST_FILE) if abs(float(i["mhz"]) - mhz) > 0.05]
        items.insert(0, {"mhz": round(mhz, 1), "rssi": rssi,
                         "ts": time.strftime("%m-%d %H:%M")})
        items = items[:40]
        self._write_list(HIST_FILE, items)
        self._fill_history(items)

    # ---------- spectrum ----------
    def _tick_spectrum(self):
        if self.spec and self.spec.update():
            self._render_spectrum()
        return True

    def _render_spectrum(self):
        w = self.area.get_allocated_width()
        if w < 100:
            w = 320
        h = self.area.get_allocated_height()
        if h < 100:
            h = 300
        bars = self.spec.bars if self.spec else [0.0] * Spectrum.BANDS
        n = len(bars)
        pad = 4
        bw = (w - pad * 2) / n
        buf = bytearray(bytes((11, 16, 22)) * (w * h))
        band = h // 4
        for y in range(band, h, band):
            buf[y * w * 3:(y + 1) * w * 3] = bytes((18, 25, 34)) * w
        base = bytes((34, 48, 62))
        buf[(h - 1) * w * 3:h * w * 3] = base * w
        for i, v in enumerate(bars):
            t = i / (n - 1)
            color = (int(255 * (0.16 + 0.84 * t)),
                     int(255 * (0.83 - 0.46 * t)),
                     int(255 * (0.72 + 0.18 * t)))
            x0 = int(pad + i * bw + bw * 0.16)
            x1 = max(x0 + 1, int(pad + i * bw + bw * 0.84))
            seg = bytes(color) * (x1 - x0)
            bh = int((h - 12) * v)
            for y in range(h - 1 - bh, h - 1):
                off = (y * w + x0) * 3
                buf[off:off + len(seg)] = seg
        pix = GdkPixbuf.Pixbuf.new_from_bytes(
            GLib.Bytes.new(bytes(buf)), GdkPixbuf.Colorspace.RGB,
            False, 8, w, h, w * 3)
        self.spec_pixbuf = pix
        self.area.set_from_pixbuf(pix)

