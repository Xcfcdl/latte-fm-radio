def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def pactl(*args, timeout=10):
    try:
        return subprocess.run(["pactl"] + list(args), capture_output=True,
                              text=True, timeout=timeout)
    except Exception:
        return None


def list_sinks():
    """sink node name -> (description, bluez profile), in pactl order."""
    r = pactl("list", "sinks")
    out = {}
    cur = None
    for line in (r.stdout if r else "").splitlines():
        s = line.strip()
        if s.startswith("Name: "):
            cur = s[6:]
            out[cur] = [cur, ""]
        elif s.startswith("Description: ") and cur:
            out[cur][0] = s[13:]
        elif s.startswith("api.bluez5.profile = ") and cur:
            q = s.split("=", 1)[1].strip().strip('"')
            out[cur][1] = q
    return {k: tuple(v) for k, v in out.items()}


def _is_hfp_sink(name, profile):
    """Hands-free (SCO/mono) sink node, not the music profile.

    On this board the SCO node reuses the A2DP node name and only differs in
    the bluez profile property, so trust the profile when pactl reports one.
    """
    if profile:
        return not profile.startswith("a2dp")
    low = name.lower()
    return "head-unit" in low or "headset-hf" in low or "hands-free" in low


def list_outputs():
    """[(target_id, label)] offered by the output selector.

    A dual-profile headset exposes a hands-free sink as well as its A2DP one
    while the card profile is changing. Radio only wants the music profile, so
    a hands-free node is hidden as long as the same device has an A2DP one.
    """
    sinks = list_sinks()
    out = [("speaker", "喇叭"), ("headphones", "有线耳机")]
    bt = [(n, d, p) for n, (d, p) in sinks.items() if n.startswith(BT_PREFIX)]
    a2dp = [(n, d) for n, d, p in bt if not _is_hfp_sink(n, p)]
    for name, desc in (a2dp or [(n, d) for n, d, p in bt]):
        label = "蓝牙 · " + desc
        if not a2dp:
            label += "（免提·单声道）"
        out.append((name, label))
    return out


def sink_for(target):
    if target in ("speaker", "headphones"):
        return SINK_LOCAL
    return target if target.startswith(BT_PREFIX) else SINK_LOCAL


def jack_state():
    """True if the headphone plug is in (used as FM antenna), None if unknown."""
    try:
        r = subprocess.run(["amixer", "-c", "0", "controls"],
                           capture_output=True, text=True, timeout=10)
        m = re.search(r"numid=(\d+),.*Headphone Jack", r.stdout or "")
        if not m:
            return None
        r = subprocess.run(["amixer", "-c", "0", "cget", "numid=" + m.group(1)],
                           capture_output=True, text=True, timeout=10)
        return (r.stdout or "").strip().endswith("values=on")
    except Exception:
        return None


def rec_dir():
    base = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_MUSIC)
    if not base:
        base = os.path.join(os.path.expanduser("~"), "Music")
    return os.path.join(base, "fm-radio")


def rec_seconds(path):
    """Duration of a recording, from its WAV payload size."""
    try:
        return max(0, (os.path.getsize(path) - 44) // (REC_RATE * REC_CHANNELS * 2))
    except OSError:
        return 0


def fmt_dur(seconds):
    seconds = max(0, int(seconds))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    return "%d:%02d:%02d" % (h, m, s) if h else "%02d:%02d" % (m, s)


def fmt_size(nbytes):
    if nbytes >= 1024 ** 3:
        return "%.2f GB" % (nbytes / 1024.0 ** 3)
    if nbytes >= 1024 ** 2:
        return "%.1f MB" % (nbytes / 1024.0 ** 2)
    return "%d KB" % max(1, nbytes // 1024)


class FMChip:
    def __init__(self):
        self.lock = threading.Lock()

    def _run(self, args, timeout=15):
        try:
            return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        except Exception:
            return None

    def _hci(self, args):
        r = self._run(["sudo", "-n", HCI] + [str(a) for a in args])
        if not r or r.returncode != 0:
            return None
        out = r.stdout.split()
        return out[1:] if out and out[0] == "OK" else None

    def write(self, reg, val):
        return self._hci(["write", hex(reg), str(val)]) is not None

    def raw(self, *data):
        return self._hci(["raw"] + [hex(d) for d in data]) is not None

    def vsc(self, *data):
        return self._hci(["vsc"] + [hex(d) for d in data]) is not None

    def read(self, reg, n=1):
        out = self._hci(["read", hex(reg), str(n)])
        if not out:
            return None
        try:
            if n == 2 and len(out) >= 2:
                return int(out[1] + out[0], 16)
            return int(out[0], 16)
        except ValueError:
            return None

    def init(self, rds=False):
        with self.lock:
            self.raw(0x00, 0x00, 0x03 if rds else 0x01)  # FM on (+RDS)
            self.raw(0xFB, 0x00, 0xE0, 0xAB, 0xE0, 0x2E)  # 108/76 MHz boundaries
            self.write(0x01, 0x0003)                # west band + stereo
            self.write(0xF8, 0x00FF)                # chip output level
            if rds:
                self.raw(0x02, 0x00, 0x02)          # flush RDS FIFO
                self.raw(0x02, 0x00, 0x00)          # RDS (not RBDS)
                self.raw(0x14, 0x00, 0x04)          # FIFO waterline

    def off(self):
        with self.lock:
            self.raw(0x00, 0x00, 0x00)

    def tune(self, khz, settle=0.85):
        with self.lock:
            self.write(0x0A, khz - 64000)
            self.raw(0x09, 0x00, 0x01)
            time.sleep(settle)
            self.write(0x05, 0x006C)                # I2S out, 75 us
            self.vsc(0x61, 0x07, 0x19, 0x18, 0x19, 0x19)
        flag = self.read(0x12, 1)
        rssi = self.read(0x0F, 1)
        snr = self.read(0xDF, 1)
        return flag, rssi, snr

    def audio_on(self):
        """Route the demodulated audio to the I2S output."""
        with self.lock:
            self.write(0x05, 0x006C)                # I2S out, 75 us
            self.vsc(0x61, 0x07, 0x19, 0x18, 0x19, 0x19)

    def tune_wait(self, khz, timeout=0.8, settle=0.25):
        """Tune and wait for usable signal meters.

        The tune flag can still carry the previous result right after a
        retune, and SNR needs about 0.2 s to reach its final value: reading
        the meters the moment the flag turns 1 reports the old channel or a
        transient value (e.g. 8 dB instead of 12 dB on a strong station).
        """
        self.write(0x0A, khz - 64000)
        self.raw(0x09, 0x00, 0x01)
        deadline = time.time() + timeout
        flag = None
        while time.time() < deadline:
            time.sleep(0.06)
            flag = self.read(0x12, 1)
            if flag is not None and (flag & 3) != 0:
                break
        if flag is None or (flag & 3) != 1:
            return flag, None, None
        time.sleep(settle)
        flag = self.read(0x12, 1)
        if flag is None or (flag & 3) != 1:
            return flag, None, None
        return flag, self.read(0x0F, 1), self.read(0xDF, 1)

    def status(self):
        flag = self.read(0x12, 1)
        rssi = self.read(0x0F, 1)
        snr = self.read(0xDF, 1)
        return flag, rssi, snr

    @staticmethod
    def rssi_dbu(raw):
        # BCM: 0x80+n means n dBuV; values below 0x80 carry no signal
        if raw is None or raw < 0x80:
            return 0
        return raw & 0x7F

    def read_rds(self):
        """Read the RDS FIFO; returns [(block, value, valid), ...]."""
        out = self._hci(["read", "0x80", "64"])
        if not out:
            return []
        try:
            data = [int(h, 16) for h in out]
        except ValueError:
            return []
        tuples = []
        for i in range(0, len(data) - 2, 3):
            meta, msb, lsb = data[i], data[i + 1], data[i + 2]
            if (meta, msb, lsb) == (0x7C, 0xFF, 0xFF):
                break
            tuples.append((meta & 0x07, (msb << 8) | lsb,
                           not (meta & 0x80)))
        return tuples

    def rds_flush(self):
        self.raw(0x02, 0x00, 0x02)
        self.raw(0x02, 0x00, 0x00)


class RDSText:
    """Accumulates RDS groups (PS name, radio text, PI, PTY)."""

    def __init__(self):
        self.pi = None
        self.pty = None
        self.ps = [" "] * 8
        self.rt = [" "] * 64
        self.group = None
        self.spare = 0
        self.c_bytes = None

    def feed(self, tuples):
        for block, val, valid in tuples:
            if not valid:
                continue
            msb, lsb = val >> 8, val & 0xFF
            if block == 0:
                self.pi = val
            elif block == 1:
                self.group = (msb >> 3) & 0x1F
                self.spare = lsb & 0x1F
                self.pty = ((msb << 3) & 0x18) | ((lsb >> 5) & 0x07)
            elif block == 2:
                self.c_bytes = (msb, lsb)
            elif block == 3 and self.group is not None:
                if self.group in (0, 1):
                    i = 2 * (self.spare & 0x03)
                    self.ps[i:i + 2] = [chr(msb), chr(lsb)]
                elif self.group == 4 and self.c_bytes:
                    i = 4 * (self.spare & 0x0F)
                    self.rt[i:i + 4] = [chr(self.c_bytes[0]), chr(self.c_bytes[1]),
                                        chr(msb), chr(lsb)]

    @staticmethod
    def _clean(chars):
        return "".join(c if 32 <= ord(c) < 127 else " " for c in chars).strip()

    def ps_name(self):
        s = self._clean(self.ps)
        return s if len(s) >= 2 else ""

    def radio_text(self):
        return self._clean(self.rt)


class Player:
    def __init__(self):
        self.loop_id = None
        self.sink = SINK_LOCAL

    @staticmethod
    def _amixer(args):
        subprocess.run(["sudo", "-n", "amixer", "-c", "0", "cset"] + list(args),
                       capture_output=True, text=True, timeout=10)

    def codec_path_on(self):
        for n in CODEC_SWITCHES:
            self._amixer(["numid=%d" % n, "on"])

    def route_speaker(self):
        for n, v in SPK_ROUTE:
            self._amixer(["numid=%d" % n, v])

    def route_headphones(self):
        for n, v in HP_ROUTE:
            self._amixer(["numid=%d" % n, v])

    def route_off(self):
        # Silence both local outputs while FM is routed to Bluetooth.
        for n in (6, 162, 163, 164, 165):
            self._amixer(["numid=%d" % n, "off"])

    def mic_path_on(self):
        for name, v in MIC_ROUTE:
            self._amixer(["name=%s" % name, v])

    def _sinks(self):
        return list_sinks()

    def _sources(self):
        r = pactl("list", "short", "sources")
        names = []
        for line in (r.stdout if r else "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2:
                names.append(parts[1])
        return names

    def _card_profile(self, card):
        r = pactl("list", "cards")
        inside = False
        for line in (r.stdout if r else "").splitlines():
            s = line.strip()
            if s.startswith("Name: "):
                inside = (s[6:] == card)
            elif inside and s.startswith("Active Profile:"):
                return s.split(":", 1)[1].strip()
        return None

    def _ensure_profile(self):
        if SINK_LOCAL in self._sinks() and SRC in self._sources():
            return True
        pactl("set-card-profile", CARD, PROFILE)
        for _ in range(40):
            if SINK_LOCAL in self._sinks() and SRC in self._sources():
                return True
            time.sleep(0.1)
        return False

    @staticmethod
    def _bt_card(sink):
        mac = sink[len(BT_PREFIX):].rsplit(".", 1)[0]
        return "bluez_card." + mac

    def _resolve_bt_sink(self, sink):
        mac = sink[len(BT_PREFIX):].rsplit(".", 1)[0]
        sinks = self._sinks()
        if sink in sinks:
            return sink
        for name in sinks:
            if name.startswith(BT_PREFIX + mac + "."):
                return name
        return sink

    def own_default_sink(self, sink):
        """Keep the system default on the sink FM plays to.

        GNOME's slider and the media keys act on the default sink. When it
        differs from ours, the two volume controls silently diverge: raising
        the system volume feeds another device and what is being heard stays
        where it was.
        """
        r = pactl("get-default-sink")
        if r and r.returncode == 0 and (r.stdout or "").strip() == sink:
            return
        pactl("set-default-sink", sink)

    def prepare(self, target):
        """Make the wanted output usable for FM; returns the sink target or None."""
        if not self._ensure_profile():
            return None
        self.mic_path_on()
        if target == "headphones":
            self.route_headphones()
            self.sink = SINK_LOCAL
            self.own_default_sink(SINK_LOCAL)
            return "headphones"
        if target == "speaker":
            self.route_speaker()
            self.sink = SINK_LOCAL
            self.own_default_sink(SINK_LOCAL)
            return "speaker"
        if target.startswith(BT_PREFIX):
            self.route_off()
            sink = self._resolve_bt_sink(target)
            card = self._bt_card(sink)
            profile = self._card_profile(card) or ""
            if not profile.startswith("a2dp"):
                pactl("set-card-profile", card, "a2dp-sink")
                for _ in range(50):
                    profile = self._card_profile(card) or ""
                    sink = self._resolve_bt_sink(target)
                    if profile.startswith("a2dp") and sink in self._sinks():
                        break
                    time.sleep(0.1)
            if not profile.startswith("a2dp") or sink not in self._sinks():
                return None
            # WirePlumber restores the route volume right after the profile lands
            time.sleep(0.3)
            self.sink = sink
            self.own_default_sink(sink)
            return sink
        return None

    def set_volume(self, pct):
        if not self.sink:
            return
        pactl("set-sink-volume", self.sink, "%d%%" % int(pct))
        pactl("set-sink-mute", self.sink, "0")

    def get_volume(self):
        """Volume percent of the sink we route to, or None."""
        if not self.sink:
            return None
        r = pactl("get-sink-volume", self.sink)
        if not r or r.returncode != 0:
            return None
        m = re.search(r"(\d+)%", r.stdout or "")
        return int(m.group(1)) if m else None

    def set_mute(self, muted):
        if self.sink:
            pactl("set-sink-mute", self.sink, "1" if muted else "0")

    def _loopback_ids(self):
        ids = []
        r = pactl("list", "short", "modules")
        for line in (r.stdout if r else "").splitlines():
            if "module-loopback" in line and "sof_cht_rt5659" in line:
                ids.append(line.split()[0])
        return ids

    def _sink_index(self, sink):
        r = pactl("list", "short", "sinks")
        for line in (r.stdout if r else "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == sink:
                return parts[0]
        return None

    def _has_sink_input(self, idx):
        r = pactl("list", "short", "sink-inputs")
        for line in (r.stdout if r else "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == idx:
                return True
        return False

    def _sink_state(self, sink):
        r = pactl("list", "short", "sinks")
        for line in (r.stdout if r else "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == sink:
                return parts[-1]
        return None

    def loopback_alive(self):
        if not self.loop_id:
            return False
        r = pactl("list", "short", "modules")
        found = False
        for line in (r.stdout or "").splitlines():
            parts = line.split()
            if parts and parts[0] == str(self.loop_id):
                found = True
                break
        if not found:
            return False
        state = self._sink_state(self.sink)
        if self.sink.startswith(BT_PREFIX) and state == "SUSPENDED":
            return False
        idx = self._sink_index(self.sink)
        return idx is not None and self._has_sink_input(idx)

    def loopback_on(self):
        self.loopback_off()
        if not self.sink:
            return None
        for _ in range(2):
            if self.sink.startswith(BT_PREFIX):
                self.sink = self._resolve_bt_sink(self.sink)
            r = pactl("load-module", "module-loopback",
                      "source=" + SRC, "sink=" + self.sink,
                      "latency_msec=80", timeout=15)
            self.loop_id = (r.stdout.strip() if r and r.returncode == 0 else None) or None
            if self.loop_id:
                time.sleep(0.15)
                idx = self._sink_index(self.sink)
                if idx and self._has_sink_input(idx):
                    return self.loop_id
            self.loopback_off()
            time.sleep(0.2)
        return None

    def loopback_off(self):
        for i in self._loopback_ids():
            pactl("unload-module", i)
        self.loop_id = None


class Recorder:
    """Capture the FM stream to a WAV file straight from the ALSA source.

    Recording taps the capture node directly, so it does not depend on the
    output routing: it keeps running while the radio is muted, routed to
    Bluetooth, or not being listened to at all.
    """

    def __init__(self):
        self.proc = None
        self.path = None
        self.started = 0.0
        self.minutes = 0

    def running(self):
        return self.proc is not None and self.proc.poll() is None

    def begin(self, path, minutes):
        self.path = path
        self.started = time.time()
        self.minutes = minutes
        self.proc = subprocess.Popen(
            ["parecord", "--device=" + SRC, "--format=s16le",
             "--rate=%d" % REC_RATE, "--channels=%d" % REC_CHANNELS,
             "--file-format=wav", path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def end(self):
        p, self.proc = self.proc, None
        if p is not None and p.poll() is None:
            p.terminate()
            try:
                p.wait(timeout=5)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()
        path, self.path = self.path, None
        return path


class Spectrum(threading.Thread):
    N = 1024
    BANDS = 46
    FMIN, FMAX = 60.0, 18000.0

    def __init__(self):
        super().__init__(daemon=True)
        self.stop_flag = threading.Event()
        self.proc = None
        self.buf = bytearray()
        self.lock = threading.Lock()
        self.bars = [0.0] * self.BANDS
        self._rev, self._tw = self._tables()
        self._edges = [self.FMIN * (self.FMAX / self.FMIN) ** (i / self.BANDS)
                       for i in range(self.BANDS + 1)]

    def _tables(self):
        n = self.N
        levels = n.bit_length() - 1
        rev = [int(format(i, "0%db" % levels)[::-1], 2) for i in range(n)]
        tw = [complex(math.cos(-2 * math.pi * k / n),
                      math.sin(-2 * math.pi * k / n)) for k in range(n // 2)]
        return rev, tw

    def _fft(self, x):
        n = self.N
        rev, tw = self._rev, self._tw
        a = [x[rev[i]] for i in range(n)]
        size = 2
        while size <= n:
            half = size // 2
            step = n // size
            for start in range(0, n, size):
                for k in range(half):
                    w = tw[k * step]
                    u = a[start + k]
                    v = a[start + k + half] * w
                    a[start + k] = u + v
                    a[start + k + half] = u - v
            size *= 2
        return a

    def run(self):
        try:
            self.proc = subprocess.Popen(
                ["parec", "--raw", "--format=s16le", "--rate=48000",
                 "--channels=1", "--latency-msec=40", "--device=" + SRC],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except Exception:
            self.proc = None
            return
        while not self.stop_flag.is_set():
            chunk = self.proc.stdout.read(8192)
            if not chunk:
                break
            with self.lock:
                self.buf.extend(chunk)
                if len(self.buf) > self.N * 16:
                    del self.buf[:-self.N * 16]

    def stop(self):
        self.stop_flag.set()
        if self.proc:
            try:
                self.proc.terminate()
            except Exception:
                pass

    def update(self):
        with self.lock:
            if len(self.buf) < self.N * 2:
                return False
            raw = bytes(self.buf[-self.N * 2:])
        samples = array.array("h")
        samples.frombytes(raw)
        mean = sum(samples) / float(self.N)
        x = [((samples[i] - mean) / 32768.0)
             * (0.5 - 0.5 * math.cos(2 * math.pi * i / (self.N - 1)))
             for i in range(self.N)]
        spec = self._fft(x)
        mags = [abs(spec[i]) / (self.N / 2.0) for i in range(self.N // 2)]
        bin_hz = 48000.0 / self.N
        out = []
        for b in range(self.BANDS):
            lo = int(self._edges[b] / bin_hz)
            hi = max(lo + 1, int(self._edges[b + 1] / bin_hz))
            peak = max(mags[lo:hi]) if hi <= len(mags) else 0.0
            db = 20 * math.log10(peak + 1e-9)
            # FM demod noise sits around -85 dB, strong stations near -60 dB
            out.append(clamp((db + 95) / 50, 0.0, 1.0))
        for i, v in enumerate(out):
            self.bars[i] = max(v, self.bars[i] * 0.80)
        return True


class Control:
    """Tiny opt-in unix-socket control channel for testing/automation."""

    def __init__(self, app, path):
        import socket
        self.app = app
        self.path = path
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        self.sock.bind(path)
        self.sock.listen(4)
        self.sock.setblocking(False)
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self._readable)

    def _readable(self, fd, cond):
        try:
            conn, _ = self.sock.accept()
        except BlockingIOError:
            return True
        conn.settimeout(2)
        data = b""
        try:
            while not data.endswith(b"\n"):
                chunk = conn.recv(1024)
                if not chunk:
                    break
                data += chunk
            resp = self.app.control_command(data.decode().strip())
            conn.sendall((json.dumps(resp) + "\n").encode())
        except Exception as e:
            try:
                conn.sendall((json.dumps({"ok": False, "error": str(e)}) + "\n").encode())
            except Exception:
                pass
        finally:
            conn.close()
        return True

    def close(self):
        try:
            self.sock.close()
            os.unlink(self.path)
        except Exception:
            pass


