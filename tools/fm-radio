        right.pack_start(rec_card, False, False, 0)

        self._refresh_recordings()
        GLib.timeout_add(1000, self._tick_jobs)

        self._refresh_outputs(initial=True)
        GLib.timeout_add(3000, self._poll_outputs)
        GLib.timeout_add(1000, self._poll_volume)

    def _make_row(self, mhz, sub, action, name="", fav=None, on_fav=None):
        row = Gtk.ListBoxRow()
