    # ---------- persistence ----------
    def _load(self):
        os.makedirs(CONF_DIR, exist_ok=True)
        try:
            with open(CONF_FILE) as f:
                c = json.load(f)
            self.current = clamp(float(c.get("freq", 94.6)), FM_MIN, FM_MAX)
            self.volume = clamp(int(c.get("volume", DEFAULT_VOLUME)), 0, 100)
            self.output = str(c.get("output", "speaker"))
            self.rec_minutes = clamp(int(c.get("rec_minutes", 30)), REC_MIN, REC_MAX)
            at = float(c["rec_at"]) if c.get("rec_at") else None
            # a schedule that expired while the app was closed is dropped
            self.rec_at = at if at and at > time.time() - 60 else None
        except Exception:
            pass

    def _save(self):
        try:
            with open(CONF_FILE, "w") as f:
                json.dump({"freq": self.current, "volume": self.volume,
                           "output": self.output,
                           "rec_minutes": self.rec_minutes,
                           "rec_at": self.rec_at}, f)
        except Exception:
            pass

    def _mark_active(self):
        try:
            with open(ACTIVE_FILE, "w") as f:
                f.write(str(os.getpid()))
        except Exception:
            pass

