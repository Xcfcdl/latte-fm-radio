    def _add_vol_drag(self, scale):
        # Gtk.Scale swallows button events, so the press is caught as it propagates
        scale.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        scale.connect("event", self._on_vol_press)
        scale.connect("button-release-event", self._on_vol_release)

    def _on_vol_press(self, scale, event):
        if event.type == Gdk.EventType.BUTTON_PRESS:
            alloc = scale.get_allocation()
            if 0 <= event.x <= alloc.width and 0 <= event.y <= alloc.height:
                self._vol_drag = True
        return False

    def _on_vol_release(self, scale, _event):
        self._vol_drag = False
        return False

    def _poll_volume(self):
        # follow volume changes made outside the app (media keys, GNOME mixer),
        # including while stopped: otherwise the level set in the mixer is
        # silently replaced by the stored one on the next play
        try:
            if self._switching or self._shutting_down or self.scanning:
                self._vol_pending = None
                return True
            if self._vol_drag:
                if int(self.vol_slider.get_value()) == self.volume:
                    self._vol_drag = False
                return True
            pct = self.player.get_volume()
            if pct is None or abs(pct - self.volume) < 2:
                self._vol_pending = None
                return True
            if self._vol_pending is not None and abs(self._vol_pending - pct) <= 1:
                self._vol_pending = None
                self.volume = pct
                self._set_volume_slider(pct)
                self._save()
            else:
                self._vol_pending = pct
        except Exception:
            pass
        return True

    def _set_volume_slider(self, value):
        self._vol_suppress = True
        self.vol_slider.set_value(value)
        self._vol_suppress = False

    def _refresh_antenna(self):
        st = jack_state()
        ctx = self.antenna_bar.get_style_context()
        ctx.remove_class("antenna-ok")
        ctx.remove_class("antenna-warn")
        if st is None:
            self.antenna_bar.set_text("天线：未知")
            ctx.add_class("antenna-warn")
        elif st:
            self.antenna_bar.set_text("天线：耳机已插入")
            ctx.add_class("antenna-ok")
        else:
