            star.set_relief(Gtk.ReliefStyle.NONE)
            star.get_style_context().add_class("fav")
            star.get_style_context().add_class("fav-on" if fav else "fav-off")
            star.set_tooltip_text("取消收藏" if fav else "收藏并置顶")
            star.connect("clicked", lambda *_: on_fav())
